# ==============================================================================
# CyberDuel AI — Command Center Dashboard Environment Variables
# Copy this file to .env.local for local development.
# For Vercel or Render: set these in your Project Settings -> Environment Variables.
# ==============================================================================

# Backend API Base URL
# - Local development (via Vite proxy): leave empty or use http://127.0.0.1:8000
# - Render / Vercel: set to your deployed backend URL (e.g. https://cyberduel-api.onrender.com or https://your-backend.up.railway.app)
# - If left empty in production, the dashboard will use relative paths (/api/v1)
VITE_API_URL=https://your-backend-api.onrender.com

# Optional: Alternative variable name supported by client.ts
# VITE_BACKEND_URL=https://your-backend-api.onrender.com
